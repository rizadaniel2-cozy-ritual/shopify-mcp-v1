<section class="cr-tools" id="cr-tools-{{ section.id }}">
  <div class="cr-tools__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="cr-tools__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cr-tools__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cr-tools__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="cr-tools__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cr-tools__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="cr-tools__card" {{ block.shopify_attributes }}>
          <div class="cr-tools__card-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'cr-tools__card-img' }}
            {%- else -%}
              {{ 'product-3' | placeholder_svg_tag: 'cr-tools__placeholder' }}
            {%- endif -%}
          </div>
          <div class="cr-tools__card-body">
            {%- if block.settings.chip != blank -%}
              <p class="cr-tools__card-chip">{{ block.settings.chip }}</p>
            {%- endif -%}
            <h3 class="cr-tools__card-title">{{ block.settings.title }}</h3>
            {%- if block.settings.tagline != blank -%}
              <p class="cr-tools__card-tagline">{{ block.settings.tagline }}</p>
            {%- endif -%}
            <span class="cr-tools__card-cta">{{ block.settings.cta_label }} →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.cr-tools {
  background: #faf7f2;
  padding: 80px 24px;
}
.cr-tools__inner { max-width: 1200px; margin: 0 auto; }
.cr-tools__header { text-align: center; margin-bottom: 52px; }
.cr-tools__eyebrow {
  font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #7c5c3e;
  font-weight: 500;
  margin-bottom: 10px;
}
.cr-tools__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(28px, 4.5vw, 46px);
  font-weight: 500;
  color: #1a1410;
  line-height: 1.12;
  margin-bottom: 12px;
}
.cr-tools__sub {
  font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  font-size: 15px;
  color: #4a3f36;
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.7;
}
.cr-tools__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
@media (max-width: 860px) {
  .cr-tools__grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 540px) {
  .cr-tools__grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
}
.cr-tools__card {
  background: white;
  border: 1px solid #e8ddd0;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  display: block;
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}
.cr-tools__card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 40px rgba(26, 20, 16, 0.09);
}
.cr-tools__card-media {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #f0ebe2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cr-tools__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.cr-tools__card:hover .cr-tools__card-img { transform: scale(1.04); }
.cr-tools__placeholder {
  width: 60%;
  height: 60%;
  opacity: 0.3;
}
.cr-tools__card-body { padding: 24px 22px 26px; }
.cr-tools__card-chip {
  font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  font-size: 10px;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: #8a7d72;
  font-weight: 500;
  margin-bottom: 8px;
}
.cr-tools__card-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 24px;
  font-weight: 500;
  color: #1a1410;
  line-height: 1.2;
  margin-bottom: 10px;
}
.cr-tools__card-tagline {
  font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  font-size: 13px;
  color: #4a3f36;
  line-height: 1.65;
  margin-bottom: 18px;
}
.cr-tools__card-cta {
  font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: #7c5c3e;
  letter-spacing: 0.03em;
}
{% endstylesheet %}

