<section class="cr-trust" id="cr-trust-{{ section.id }}">
  <div class="cr-trust__inner">
    {%- for block in section.blocks -%}
      <div class="cr-trust__pillar" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <div class="cr-trust__icon" aria-hidden="true">{{ block.settings.icon }}</div>
        {%- endif -%}
        <h3 class="cr-trust__heading">{{ block.settings.heading }}</h3>
        <p class="cr-trust__body">{{ block.settings.body }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.cr-trust {
  background: white;
  border-top: 1px solid #e8ddd0;
  border-bottom: 1px solid #e8ddd0;
  padding: 64px 24px;
}
.cr-trust__inner {
  max-width: 980px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48px;
}
@media (max-width: 700px) {
  .cr-trust__inner { grid-template-columns: 1fr; gap: 36px; max-width: 420px; }
}
.cr-trust__pillar { text-align: center; padding: 0 8px; }
.cr-trust__icon {
  font-size: 30px;
  margin-bottom: 16px;
  display: block;
  line-height: 1;
}
.cr-trust__heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 20px;
  font-weight: 500;
  color: #1a1410;
  margin-bottom: 10px;
  line-height: 1.3;
}
.cr-trust__body {
  font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
  font-size: 13px;
  color: #4a3f36;
  line-height: 1.75;
  font-weight: 300;
}
{% endstylesheet %}

{% schema %}
{
  "name": "CR Trust Icons",
  "tag": "section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "trust_pillar",
      "name": "Trust pillar",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "30-day money-back guarantee"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "If your skin doesn't look or feel different in 30 days, we return every penny. No forms. No questions. No drama."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CR Trust Icons",
      "blocks": [
        {
          "type": "trust_pillar",
          "settings": {
            "icon": "🛡️",
            "heading": "30-day money-back guarantee",
            "body": "If your skin doesn't look or feel different in 30 days, we return every penny. No forms. No questions. No drama."
          }
        },
        {
          "type": "trust_pillar",
          "settings": {
            "icon": "🚚",
            "heading": "Free shipping on every order",
            "body": "Free shipping to the US and UK, always. No minimum spend. Delivered to your door in 5–8 days."
          }
        },
        {
          "type": "trust_pillar",
          "settings": {
            "icon": "✦",
            "heading": "CE certified & safety tested",
            "body": "Every device is independently CE certified and safety tested. We only sell tools we'd use ourselves — every night."
          }
        }
      ]
    }
  ]
}
{% endschema %}
